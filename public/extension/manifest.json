{
  "manifest_version": 3,
  "name": "SALLI",
  "version": "1.1",
  "permissions": [
    "tabs",
    "offscreen",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["modules/toast/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SALLI",
    "default_icon": "icon.png"
  },
  
  "icons": {
    "16": "icon.png", 
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "modules/audio/*.mp3"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}